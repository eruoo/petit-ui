{
  "name": "petit-ui-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm lint && pnpm format:check && pnpm test && pnpm site:check && pnpm site:build",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --deny-warnings --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "pnpm --filter petit-ui test && pnpm test:release",
    "test:release": "node --test .github/scripts/release-metadata.test.mjs",
    "prepare": "simple-git-hooks",
    "changelog": "git-cliff --config cliff.toml --offline",
    "release:bump": "pnpm check && bumpp",
    "site:dev": "pnpm --filter petit-ui-site dev",
    "site:build": "pnpm --filter petit-ui-site build",
    "site:preview": "pnpm --filter petit-ui-site preview",
    "site:check": "pnpm --filter petit-ui-site typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "bumpp": "12.3.0",
    "git-cliff": "2.14.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "simple-git-hooks": "2.14.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check",
    "commit-msg": "pnpm exec commitlint --edit \"$1\"",
    "preserveUnused": true
  },
  "packageManager": "pnpm@11.25.0"
}
